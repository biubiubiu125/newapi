# 端口号
# PORT=3000
# 前端基础URL
# FRONTEND_BASE_URL=https://your-frontend-url.com


# 调试相关配置
# 启用pprof
# ENABLE_PPROF=true
# 启用调试模式
# DEBUG=true
# Pyroscope 配置
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=new-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# 数据库相关配置
# 启用错误日志记录
# ERROR_LOG_ENABLED=true
# 数据库连接字符串
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# 日志数据库连接字符串
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# 使用 ClickHouse 作为日志库时可设置：
# LOG_SQL_DSN=clickhouse://default:password@newapi-clickhouse:9000/new_api_logs
# LOG_SQL_CLICKHOUSE_TTL_DAYS=30
# SQLite数据库路径
# SQLITE_PATH=/path/to/sqlite.db
# 数据库最大空闲连接数
# SQL_MAX_IDLE_CONNS=25
# 数据库最大打开连接数
# SQL_MAX_OPEN_CONNS=80
# 数据库连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60


# 缓存相关配置
# Redis连接字符串
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# 同步频率（单位：秒）
# SYNC_FREQUENCY=60
# 内存缓存启用
# MEMORY_CACHE_ENABLED=true
# 渠道更新频率（单位：秒）
# CHANNEL_UPDATE_FREQUENCY=30
# 批量更新启用
# BATCH_UPDATE_ENABLED=true
# 批量更新间隔（单位：秒）
# BATCH_UPDATE_INTERVAL=5

# 任务和功能配置
# 更新任务启用
# UPDATE_TASK=true
# 生图异步任务 worker，默认启用
# IMAGE_TASK_WORKER_ENABLED=true
# 生图异步任务 worker 空闲轮询间隔，单位秒
# IMAGE_TASK_WORKER_IDLE_SECONDS=5
# 生图异步任务全局并发
# IMAGE_TASK_WORKER_CONCURRENCY=20
# 单渠道生图异步任务并发
# IMAGE_TASK_CHANNEL_CONCURRENCY=10
# 异步任务桥接状态批量轮询大小，最大 100
# IMAGE_TASK_BATCH_POLL_SIZE=20
# 生图异步任务 lease 时长，单位秒
# IMAGE_TASK_LEASE_SECONDS=120
# 异步任务桥接任务响应最大体积，单位 MB；0 表示沿用 MAX_FILE_DOWNLOAD_MB
# IMAGE_TASK_HTTP_RESPONSE_MAX_MB=0

# 对话超时设置
# 所有请求超时时间，单位秒，默认为0，表示不限制
# RELAY_TIMEOUT=0
# Relay HTTP 客户端空闲连接超时时间，单位秒，默认 90，设置为 0 表示不限制
# RELAY_IDLE_CONN_TIMEOUT=90
# 流模式无响应超时时间，单位秒，如果出现空补全可以尝试改为更大值
# STREAMING_TIMEOUT=300
# 匿名请求体限制，单位 KB，默认 512，设置为 0 表示不限制
# ANONYMOUS_REQUEST_BODY_LIMIT_KB=512

# TLS / HTTP 跳过验证设置
# TLS_INSECURE_SKIP_VERIFY=false

# Gemini 识别图片 最大图片数量
# GEMINI_VISION_MAX_IMAGE_NUM=16

# 会话密钥
# Generate with: openssl rand -hex 32

# Docker Compose deployment. Required; do not use default or shared passwords.
POSTGRES_USER=root
POSTGRES_PASSWORD=
POSTGRES_DB=new-api
REDIS_PASSWORD=
SESSION_SECRET=
# Enable Secure session cookies only when all trusted entry URLs are HTTPS.
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_TRUSTED_URL=https://example.com,https://admin.example.com
APP_PORT=3000
CONTAINER_PREFIX=newapi
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DB=new_api_logs
# LOG_SQL_CLICKHOUSE_TTL_DAYS=0
NODE_NAME=new-api-node-1
DB_STARTUP_CONNECT_TIMEOUT_SECONDS=60
DB_STARTUP_CONNECT_RETRY_INTERVAL_MS=1000
CORS_ALLOWED_ORIGINS=
TRUSTED_REDIRECT_DOMAINS=example.com
GLOBAL_WEB_RATE_LIMIT_ENABLE=true
GLOBAL_WEB_RATE_LIMIT=600
GLOBAL_WEB_RATE_LIMIT_DURATION=180
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=180
GLOBAL_API_RATE_LIMIT_DURATION=180
CRITICAL_RATE_LIMIT_ENABLE=true
CRITICAL_RATE_LIMIT=50
CRITICAL_RATE_LIMIT_DURATION=1200

# 返佣链路测试模式。仅测试环境启用；启用后才允许 Creem dummy mock 支付和无密钥 webhook 验签跳过。
REFERRAL_TEST_MODE=false

# 其他配置
# 生成默认token
# GENERATE_DEFAULT_TOKEN=false
# Cohere 安全设置
# COHERE_SAFETY_SETTING=NONE
# 是否统计图片token
# GET_MEDIA_TOKEN=true
# 是否在非流（stream=false）情况下统计图片token
# GET_MEDIA_TOKEN_NOT_STREAM=false
# 设置 Dify 渠道是否输出工作流和节点信息到客户端
# DIFY_DEBUG=true

# LinuxDo相关配置
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# 节点类型
# 如果是主节点则为master
# NODE_TYPE=master

# 可信任重定向域名列表（逗号分隔，支持子域名匹配）
# 用于验证支付成功/取消回调URL的域名安全性
# 示例: example.com,myapp.io 将允许 example.com, sub.example.com, myapp.io 等
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io

# 真实客户端 IP 获取。默认不信任任何真实 IP 请求头，只使用直连来源 IP。
# 只有当请求来源 IP 命中 TRUSTED_PROXY_CIDRS 时，才会读取 TRUSTED_PROXY_HEADERS 中配置的头。
# 使用 CDN 时，请把 CDN 官方回源 IP 段加入 TRUSTED_PROXY_CIDRS，并配置 CDN 真实 IP 头（如 CF-Connecting-IP）。
# 使用 Nginx 的 X-Real-IP 或 X-Forwarded-For 时，请确认反向代理会覆盖同名入站头后再显式加入。
# TRUSTED_PROXY_HEADERS=CF-Connecting-IP,True-Client-IP
# TRUSTED_PROXY_CIDRS=173.245.48.0/20,103.21.244.0/22
